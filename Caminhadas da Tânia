<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Caminhadas da Tânia</title>
  <!-- Google Fonts & Bootstrap Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css"/>
  <style>
    :root {
      --rosa1: #fff0f6;
      --rosa2: #f8bbd0;
      --rosa3: #f06292;
      --rosa4: #ad1457;
      --rosa5: #ffb6d5;
      --glass: rgba(255,255,255,0.55);
      --glass2: rgba(255,240,246,0.85);
      --shadow: 0 8px 32px rgba(240,98,146,0.18);
      --shadow2: 0 2px 8px rgba(240,98,146,0.10);
    }
    body {
      font-family: 'Montserrat', Arial, sans-serif;
      background: linear-gradient(135deg, var(--rosa1) 0%, var(--rosa5) 100%);
      margin: 0; padding: 0; color: var(--rosa4);
      min-height: 100vh; display: flex; flex-direction: column;
    }
    header {
      background: var(--glass2);
      padding: 36px 0 18px 0;
      text-align: center;
      box-shadow: var(--shadow);
      border-bottom-left-radius: 36px;
      border-bottom-right-radius: 36px;
      position: relative; z-index: 2;
      backdrop-filter: blur(8px);
    }
    h1 {
      margin: 0; font-size: 2.7em; color: var(--rosa3); letter-spacing: 2px; font-weight: 700;
      display: flex; align-items: center; justify-content: center; gap: 12px;
    }
    h1 .bi { font-size: 1.2em; color: var(--rosa4);}
    main { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 36px 8px 0 8px; }
    .dashboard { display: flex; flex-wrap: wrap; justify-content: center; gap: 28px; margin-bottom: 36px; }
    .card {
      background: var(--glass);
      border-radius: 22px;
      box-shadow: var(--shadow);
      padding: 32px 40px;
      min-width: 150px;
      text-align: center;
      transition: transform .15s, box-shadow .15s;
      position: relative;
      backdrop-filter: blur(12px);
      border: 1.5px solid #fff6fa88;
      overflow:hidden;
    }
    .card:hover { transform: translateY(-6px) scale(1.04); box-shadow: 0 10px 36px rgba(240,98,146,0.19);}
    .card h2 { margin-bottom: 14px; color: var(--rosa4); font-size: 1.13em; font-weight:700; letter-spacing:.5px;}
    .card p { font-size: 2.3em; margin: 0; color: var(--rosa3); font-weight:700; letter-spacing:.5px;}
    .card .bi { position:absolute; top:-18px; right:-18px; font-size:2em; opacity:.13; pointer-events:none;}
    .btn-group { display:flex; gap:18px; margin-bottom:36px;}
    button {
      padding:16px 38px; font-size:1.13em; border-radius:14px; border:none;
      background: linear-gradient(90deg, var(--rosa3), var(--rosa2));
      color:#fff; font-weight:700; cursor:pointer; box-shadow:var(--shadow2);
      transition:.18s background,.12s transform; outline:none; position:relative; overflow:hidden;
    }
    button[disabled] { background:#f7f7f7; color:#bbb; cursor:not-allowed; box-shadow:none; opacity:.7;}
    button:not([disabled]):hover { background: linear-gradient(90deg, var(--rosa4), var(--rosa3)); transform: scale(1.045);}
    #map {
      width:min(95vw,520px); height:min(60vw,320px); min-height:170px;
      margin:0 auto 36px auto; border-radius:20px;
      box-shadow: 0 0 0 6px #fff6fa, 0 0 24px #f0629244, var(--shadow);
      overflow:hidden; border:3.5px solid #f06292cc;
      animation:fadex .9s cubic-bezier(.4,.7,.3,1) both; position:relative;
    }
    .leaflet-container {
      background:#fff !important;
      filter:saturate(1.08) contrast(1.04);
    }
    .leaflet-control-zoom {
      border-radius:12px !important; overflow:hidden; box-shadow:0 4px 16px #f0629244;
    }
    .leaflet-control-zoom a {
      background:#fff6fa !important; color:#ad1457 !important; font-weight:bold; font-size:1.5em !important;
    }
    .leaflet-control-zoom a:hover {
      background:#f06292 !important; color:#fff !important;
    }
    footer {
      text-align:center; padding:20px 0; background:var(--glass2); color:var(--rosa3);
      font-size:.99em; letter-spacing:.5px; border-top-left-radius:26px; border-top-right-radius:26px;
      box-shadow:0 -2px 12px rgba(240,98,146,0.07); margin-top:auto; backdrop-filter: blur(8px);
    }
    /* Animação de entrada */
    .fade-in { animation:fadex .7s cubic-bezier(.4,.7,.3,1) both;}
    @keyframes fadex { from{opacity:.1;transform:translateY(30px);} to{opacity:1;transform:none;} }
    /* Responsivo */
    @media (max-width:650px) { .dashboard { flex-direction:column; gap:18px;} .card { min-width:auto;width:auto;} #map { height:min(50vw,200px);} }
    @media (max-width:400px) { h1 {font-size:1.5em;} .card {padding:18px;} #map {height:min(40vw,110px);} }
    /* Glassmorphism extra */
    .card::before {
      content:""; position:absolute; left:-30%; top:-30%; width:160%; height:160%;
      background:
        radial-gradient(circle at top left,#fff6fa55 40%,transparent 80%),
        radial-gradient(circle at bottom right,#f0629215 30%,transparent 80%);
      z-index:-1; pointer-events:none; filter:saturate(1.3) blur(4px); opacity:.7; transition:.3s opacity;
    }
    .card:hover::before { opacity:.95;}
    /* Pulse marker no mapa */
    .pulse-marker {
      width:26px;height:26px;border-radius:50%;background:#f06292cc;border:.15em solid #fff6fa99;
      box-shadow: 0 0 .5em .5em #f0629244, 0 0 .5em .5em #fff6fa44, 0 0 .5em .5em #f0629244;
      animation:pulseMapMarker 1.4s infinite cubic-bezier(.4,.7,.3,1);
      position:absolute;left:-13px;top:-13px; z-index:9999 !important; pointer-events:none;
    }
    @keyframes pulseMapMarker {
      0% {box-shadow: 0 0 .5em .5em #f0629244, 0 0 .5em .5em #fff6fa44, 0 0 .5em .5em #f0629244;}
      70% {box-shadow: 0 0 .9em .9em #f0629222, 0 0 .9em .9em #fff6fa22, 0 0 .9em .9em #f0629222;}
      100% {box-shadow: 0 0 .5em .5em #f0629244, 0 0 .5em .5em #fff6fa44, 0 0 .5em .5em #f0629244;}
    }
    /* Tooltip custom */
    .leaflet-tooltip.my-tooltip {
      background:#fff6faee;color:#ad1457;font-weight:bold;font-size:.97em;border-radius:.9em;padding:.45em .9em;border:none;
      box-shadow:var(--shadow2); filter:saturate(1.2) blur(.2px); letter-spacing:.5px;text-align:center;text-shadow:none !important;
    }
    /* Ícone animado */
    .icon-anim { animation:bounceIcon .9s infinite alternate cubic-bezier(.4,.7,.3,1); display:inline-block }
    @keyframes bounceIcon { to{transform:translateY(-8%);} }
  </style>
</head>
<body>
<header>
  <h1><i class="bi bi-flower1 icon-anim"></i> Caminhadas da Tânia</h1>
</header>
<main>
  <section class="dashboard fade-in">
    <div class="card">
      <h2>Passos</h2>
      <p id="stepCount">0</p>
      <i class="bi bi-shoe-print"></i>
    </div>
    <div class="card">
      <h2>Distância</h2>
      <p id="distance">0,00 km (0 m)</p>
      <i class="bi bi-signpost"></i>
    </div>
    <div class="card">
      <h2>Duração</h2>
      <p id="duration">00:00:00</p>
      <i class="bi bi-clock-history"></i>
    </div>
  </section>
  <div class="btn-group fade-in">
    <button id="startBtn"><i class="bi bi-play-fill"></i> Iniciar Caminhada</button>
    <button id="stopBtn" disabled><i class="bi bi-stop-fill"></i> Parar Caminhada</button>
  </div>
  <div id="map" class="fade-in"></div>
</main>
<footer>
  &copy; Caminhadas da Tânia
</footer>
<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script>
let watchId = null, positions = [], stepCount = 0, distance = 0.0, startTime = null, timerInterval = null;
const stepLength = 0.75; // metros (ajuste conforme necessário)
const stepCountEl = document.getElementById('stepCount');
const distanceEl = document.getElementById('distance');
const durationEl = document.getElementById('duration');
const startBtn = document.getElementById('startBtn');
const stopBtn = document.getElementById('stopBtn');
const mapEl = document.getElementById('map');
let map = null, polyline = null, marker = null;

function formatTime(ms) {
  const totalSeconds = Math.floor(ms / 1000);
  const h = String(Math.floor(totalSeconds / 3600)).padStart(2,'0');
  const m = String(Math.floor((totalSeconds %3600)/60)).padStart(2,'0');
  const s = String(totalSeconds%60).padStart(2,'0');
  return `${h}:${m}:${s}`;
}
function haversine(lat1, lon1, lat2, lon2) {
  const R = 6371000, toRad = x => x * Math.PI /180, dLat = toRad(lat2-lat1), dLon = toRad(lon2-lon1),
        a = Math.sin(dLat/2)**2 + Math.cos(toRad(lat1))*Math.cos(toRad(lat2))*Math.sin(dLon/2)**2,
        c = 2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
  return R*c;
}
function updateStats() {
  stepCountEl.textContent = Math.round(stepCount).toString();
  const km = Math.floor(distance), metros = Math.round((distance-km)*1000);
  distanceEl.textContent = `${distance.toFixed(2).replace('.',',')} km (${metros} m)`;
}
function updateMap() {
  if (!map) {
    // Mapa claro estilizado
    map = L.map('map', { zoomControl:true }).setView([0,0],16);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution:'&copy; OpenStreetMap contributors', maxZoom:19
    }).addTo(map);
    polyline = L.polyline([], {color:'#f06292', weight:7, opacity:.95}).addTo(map);
    marker = L.circleMarker([0,0], { radius:13, color:'#fff', fillColor:'#f06292', fillOpacity:.95, weight:5 }).addTo(map);
  }
  if (positions.length) {
    const latlngs = positions.map(p=>[p.latitude,p.longitude]);
    polyline.setLatLngs(latlngs);
    marker.setLatLng(latlngs[latlngs.length-1]);
    // Pulse marker visual extra
    setTimeout(()=>{
      let el=map.getContainer().querySelector('.pulse-marker');
      if(!el){
        let pDiv=document.createElement('div');
        pDiv.className='pulse-marker';
        marker._path.parentNode.appendChild(pDiv);
      }
    },100);
    map.fitBounds(polyline.getBounds(),{padding:[30,30]});
    setTimeout(()=>{ map.invalidateSize(); },200);
    marker.bindTooltip("Você está aqui!",{permanent:false,className:'my-tooltip'}).openTooltip();
  } else {
    polyline.setLatLngs([]);
    marker.setLatLng([0,0]);
    map.setView([0,0],16);
  }
}
function startWalk() {
  positions=[]; stepCount=0; distance=0.0; startTime=Date.now();
  updateStats(); durationEl.textContent="00:00:00";
  startBtn.disabled=true; stopBtn.disabled=false;
  if (!map) updateMap();
  if (navigator.geolocation) {
    watchId=navigator.geolocation.watchPosition(
      pos=>{
        const {latitude,longitude,accuracy}=pos.coords;
        if (accuracy>15) return;
        if (positions.length===0) {
          positions.push({latitude,longitude});
          updateStats(); updateMap(); return;
        }
        const lastPos=positions[positions.length-1];
        const d=haversine(lastPos.latitude,lastPos.longitude,latitude,longitude);
        if (d>1 && d<100) {
          distance+=d/1000;
          stepCount+=d/stepLength;
          positions.push({latitude,longitude});
          updateStats(); updateMap();
        }
      },
      err=>alert("Erro ao acessar GPS!"),
      { enableHighAccuracy:true, maximumAge:500, timeout:8000 }
    );
    timerInterval=setInterval(()=>{ durationEl.textContent=formatTime(Date.now()-startTime); },800);
    navigator.geolocation.getCurrentPosition(pos=>{
      if(map && pos.coords) map.setView([pos.coords.latitude,pos.coords.longitude],17);
      setTimeout(()=>{ map.invalidateSize(); },200);
    });
  } else {
    alert("Geolocalização não suportada!");
    startBtn.disabled=false; stopBtn.disabled=true;
  }
}
function stopWalk() {
  if(watchId!==null){
    navigator.geolocation.clearWatch(watchId); watchId=null;
    clearInterval(timerInterval); timerInterval=null;
    startBtn.disabled=false; stopBtn.disabled=true;
    updateMap();
    const km=Math.floor(distance), metros=Math.round((distance-km)*1000);
    alert(`Caminhada finalizada!\nPassos estimados:${Math.round(stepCount)}\nDistância total:\n${distance.toFixed(2).replace('.',',')} km (${metros} m)`);
  }
}
startBtn.addEventListener('click',startWalk);
stopBtn.addEventListener('click',stopWalk);
window.addEventListener('DOMContentLoaded',()=>setTimeout(updateMap,300));
</script>
</body>
</html>
